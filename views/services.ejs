<!doctype html>
<html lang="en">
  <%- include('partials/head') %>

  <body data-page="services">
    <%- include('partials/header') %>

    <main>
      <section class="page-hero">
        <div class="page-hero__glow"></div>
        <div class="container">
          <div class="crumb hero-eyebrow"><a href="/">Home</a> <i data-lucide="chevron-right"></i> Services</div>
          <h1 class="hero-headline">Services that take you from <span class="grad">idea to impact</span></h1>
          <p class="hero-sub">Pick one or string a few together. Either way, you get the same senior team and the same care from kickoff to launch.</p>
        </div>
      </section>

      <!-- ===== SERVICES FULL ===== -->
      <section class="section--tight">
        <div class="container">
          <div class="services__grid" id="servicesGrid" data-stagger>
            <%- include('partials/services_grid', { fullServices: true }) %>
          </div>
        </div>
      </section>

      <!-- ===== APPROACH SPLIT ===== -->
      <section class="section">
        <div class="container">
          <div class="split split--reverse">
            <div class="split__media" data-reveal>
              <img src="https://images.unsplash.com/photo-1531403009284-440f080d1e12?auto=format&fit=crop&q=80&w=1200" alt="Planning a project" loading="lazy" />
            </div>
            <div data-reveal>
              <span class="tag"><i data-lucide="shield-check"></i> No surprises</span>
              <h2>You'll always know what you're paying for</h2>
              <p>Before we write a single line of code, you get a clear proposal: scope, timeline, and a price that won't quietly grow. If something changes, we talk about it first.</p>
              <ul class="why__list">
                <li><i data-lucide="check"></i> Fixed-price or time-and-materials — your call</li>
                <li><i data-lucide="check"></i> A real human as your single point of contact</li>
                <li><i data-lucide="check"></i> 30 days of free support after every launch</li>
                <li><i data-lucide="check"></i> Code and assets are always yours</li>
              </ul>
              <a href="/contact" class="btn btn--primary">Request a quote <i data-lucide="arrow-right"></i></a>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== PROCESS ===== -->
      <section class="section">
        <div class="container">
          <div class="section__head" data-reveal>
            <span class="tag"><i data-lucide="route"></i> Our process</span>
            <h2 class="section__title">How a project <span class="grad">actually unfolds</span></h2>
            <p class="section__lead">Calm, collaborative, and easy to follow — even if it's your first time building software.</p>
          </div>
          <div class="process__track" id="servicesProcess" data-stagger>
            <%- include('partials/process') %>
          </div>
        </div>
      </section>

      <!-- ===== FAQ ===== -->
      <section class="section">
        <div class="container faq__inner">
          <div class="section__head section__head--left" data-reveal>
            <span class="tag"><i data-lucide="help-circle"></i> FAQ</span>
            <h2 class="section__title">Good questions, <span class="grad">answered</span></h2>
            <p class="section__lead">Still unsure? Reach out — a real person always replies.</p>
            <a href="/contact" class="btn btn--ghost">Ask us anything <i data-lucide="arrow-right"></i></a>
          </div>
          <div class="faq__list" id="servicesFaq" data-stagger>
            <%- include('partials/faq') %>
          </div>
        </div>
      </section>

      <!-- ===== CTA ===== -->
      <section class="section">
        <div class="container">
          <div class="cta__panel" data-reveal>
            <div class="cta__glow"></div>
            <span class="tag tag--light"><i data-lucide="sparkles"></i> Let's build</span>
            <h2 class="cta__title">Not sure which service <span class="grad">you need</span>?</h2>
            <p class="cta__sub">That's completely normal. Tell us the problem you're trying to solve and we'll suggest the right path — even if it's not with us.</p>
            <div class="cta__actions"><a href="/contact" class="btn btn--primary btn--lg">Talk it through <i data-lucide="arrow-right"></i></a></div>
          </div>
        </div>
      </section>
    </main>

    <%- include('partials/footer') %>

    <button class="to-top" id="toTop" aria-label="Back to top"><i data-lucide="arrow-up"></i></button>

    <%- include('partials/scripts') %>
  </body>
</html>
