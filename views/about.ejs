<!doctype html>
<html lang="en">
  <%- include('partials/head') %>

  <body data-page="about">
    <%- include('partials/header') %>

    <main>
      <!-- ===== PAGE HERO ===== -->
      <section class="page-hero">
        <div class="page-hero__glow"></div>
        <div class="container">
          <div class="crumb hero-eyebrow"><a href="/">Home</a> <i data-lucide="chevron-right"></i> About</div>
          <h1 class="hero-headline">A small team with a <span class="grad">big soft spot</span> for good software</h1>
          <p class="hero-sub">Engineers, designers and strategists who genuinely enjoy the craft. We've spent a decade helping people turn "what if" into something real and working.</p>
        </div>
      </section>

      <!-- ===== STATS ===== -->
      <section class="section--tight">
        <div class="container">
          <div class="stats__grid" id="aboutStats" data-stagger>
            <%- include('partials/stats', { statsSet: 'about' }) %>
          </div>
        </div>
      </section>

      <!-- ===== STORY ===== -->
      <section class="section">
        <div class="container">
          <div class="split">
            <div data-reveal>
              <span class="tag"><i data-lucide="book-open"></i> Our story</span>
              <h2>It started with one stubborn belief</h2>
              <p>That world-class technology shouldn't only be for companies with world-class budgets. Back in 2014 we were a handful of engineers building things on the side for people we believed in.</p>
              <p>That belief never left. Today we're a remote-first studio of fifty, but we still pick projects the same way — by whether we'd be proud to put our name on them.</p>
              <a href="/contact" class="btn btn--primary" style="margin-top:8px">Work with us <i data-lucide="arrow-right"></i></a>
            </div>
            <div class="split__media" data-reveal>
              <img src="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?auto=format&fit=crop&q=80&w=1200" alt="The TechNeural team" loading="lazy" />
            </div>
          </div>
        </div>
      </section>

      <!-- ===== VALUES ===== -->
      <section class="section">
        <div class="container">
          <div class="section__head" data-reveal>
            <span class="tag"><i data-lucide="heart-handshake"></i> What we stand for</span>
            <h2 class="section__title">The values we <span class="grad">actually live by</span></h2>
            <p class="section__lead">Not poster slogans — these are the things we argue about, hire for, and hold each other to.</p>
          </div>
          <div class="features__grid features__grid--3" id="aboutValues" data-stagger>
            <%- include('partials/values') %>
          </div>
        </div>
      </section>

      <!-- ===== TIMELINE ===== -->
      <section class="section">
        <div class="container">
          <div class="section__head" data-reveal>
            <span class="tag"><i data-lucide="milestone"></i> The journey</span>
            <h2 class="section__title">A decade, in <span class="grad">a few moments</span></h2>
          </div>
          <div class="timeline" id="aboutTimeline" data-reveal>
            <%- include('partials/timeline') %>
          </div>
        </div>
      </section>

      <!-- ===== TEAM ===== -->
      <section class="section">
        <div class="container">
          <div class="section__head" data-reveal>
            <span class="tag"><i data-lucide="users"></i> The humans</span>
            <h2 class="section__title">A few of the faces <span class="grad">behind the work</span></h2>
            <p class="section__lead">Senior, kind, and a little obsessed with getting things right.</p>
          </div>
          <div class="team__grid" id="aboutTeam" data-stagger>
            <%- include('partials/team') %>
          </div>
        </div>
      </section>

      <!-- ===== CTA ===== -->
      <section class="section">
        <div class="container">
          <div class="cta__panel" data-reveal>
            <div class="cta__glow"></div>
            <span class="tag tag--light"><i data-lucide="sparkles"></i> Let's talk</span>
            <h2 class="cta__title">Like how we think? <span class="grad">Let's build together</span></h2>
            <p class="cta__sub">Whether you're at the napkin-sketch stage or scaling fast, we'd love to hear what you're working on.</p>
            <div class="cta__actions"><a href="/contact" class="btn btn--primary btn--lg">Get in touch <i data-lucide="arrow-right"></i></a></div>
          </div>
        </div>
      </section>
    </main>

    <%- include('partials/footer') %>

    <button class="to-top" id="toTop" aria-label="Back to top"><i data-lucide="arrow-up"></i></button>

    <%- include('partials/scripts') %>
  </body>
</html>
