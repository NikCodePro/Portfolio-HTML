<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>New Project Inquiry — <%= name %></title>
  <style>
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: #0b0716;
      color: #dfdbed;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }
    .wrapper {
      width: 100%;
      background-color: #0b0716;
      padding: 40px 0;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #120d24;
      border: 1px solid rgba(124, 58, 237, 0.2);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }
    .header {
      background: linear-gradient(135deg, #7c3aed 0%, #c026d3 100%);
      padding: 40px 30px;
      text-align: center;
    }
    .header h1 {
      color: #ffffff;
      margin: 0;
      font-size: 26px;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    .header p {
      color: rgba(255, 255, 255, 0.85);
      margin: 10px 0 0 0;
      font-size: 15px;
    }
    .content {
      padding: 40px 30px;
    }
    .info-card {
      background-color: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      padding: 24px;
      margin-bottom: 24px;
    }
    .info-row {
      margin-bottom: 16px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      padding-bottom: 12px;
    }
    .info-row:last-child {
      margin-bottom: 0;
      border-bottom: none;
      padding-bottom: 0;
    }
    .info-label {
      font-size: 12px;
      color: #9d8ec2;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 4px;
      font-weight: 600;
    }
    .info-value {
      font-size: 16px;
      color: #ffffff;
      font-weight: 500;
    }
    .message-box {
      font-size: 15px;
      line-height: 1.6;
      color: #dfdbed;
      white-space: pre-line;
      background-color: rgba(124, 58, 237, 0.05);
      border-left: 3px solid #7c3aed;
      padding: 16px;
      border-radius: 0 8px 8px 0;
    }
    .footer {
      text-align: center;
      padding: 30px;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
      font-size: 12px;
      color: #72629b;
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="container">
      <div class="header">
        <h1>New Contact Submission</h1>
        <p>A user has filled out the inquiry form on TechNeural.</p>
      </div>
      <div class="content">
        <div class="info-card">
          <div class="info-row">
            <div class="info-label">Sender Name</div>
            <div class="info-value"><%= name %></div>
          </div>
          <div class="info-row">
            <div class="info-label">Email Address</div>
            <div class="info-value"><%= email %></div>
          </div>
          <div class="info-row">
            <div class="info-label">Phone Number</div>
            <div class="info-value"><%= phone || 'Not provided' %></div>
          </div>
          <div class="info-row">
            <div class="info-label">Requested Service</div>
            <div class="info-value"><%= service || 'Not specified' %></div>
          </div>
        </div>
        <div class="info-label" style="margin-bottom: 8px;">Project Details / Message</div>
        <div class="message-box"><%= message %></div>
      </div>
      <div class="footer">
        TechNeural Portfolio Server &bull; Automated System
      </div>
    </div>
  </div>
</body>
</html>
